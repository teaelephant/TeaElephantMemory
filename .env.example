# Local PostgreSQL credentials. Use URL-safe values in the Compose PG_DSN.
POSTGRES_USER=teaelephant
POSTGRES_PASSWORD=teaelephant
POSTGRES_DB=teaelephant
POSTGRES_PORT=5432
SERVER_PORT=8080
LOG_LEVEL=info

# Fill in the API credentials before starting the server.
OPEN_AI_TOKEN=
OPENWEATHER_APIKEY=
APPLE_AUTH_CLIENT_ID=xax.TeaElephant
APPLE_AUTH_TEAM_ID=
APPLE_AUTH_KEY_ID=

# Existing host files, mounted read-only into the server container.
APPLE_AUTH_SECRET_FILE=./secrets/AuthKey.p8
ADMIN_PUBLIC_KEY_FILE=./secrets/admin_public_key.pem
